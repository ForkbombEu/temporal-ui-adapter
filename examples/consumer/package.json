{
  "name": "consumer",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "node -e \"require('node:fs').accessSync('../../package/package.json')\"",
    "prepare": "svelte-kit sync",
    "dev": "rm -rf node_modules/.vite && vite dev --port 5199 --force",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^6.0.0",
    "@sveltejs/kit": "^2.53.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.1.17",
    "svelte": "^5.53.3",
    "svelte-check": "^4.1.5",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.0",
    "vite": "^7.2.6"
  },
  "dependencies": {
    "@forkbombeu/temporal-ui": "file:../../package"
  }
}
